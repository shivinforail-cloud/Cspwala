// Deploy this match block in the standalone Shadow Agent Firebase project.
// It scopes every Shadow Agent cloud record to the signed-in Firebase user.
// Multiple PCs signed into the same Firebase account can share workflows,
// customer contexts, observations and device state; other users cannot read them.

match /shadowAgents/{userId}/{document=**} {
  allow read, write: if request.auth != null
                     && request.auth.uid == userId;
}
