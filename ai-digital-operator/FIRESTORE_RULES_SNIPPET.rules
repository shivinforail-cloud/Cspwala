// Merge this match block into the existing CSPWALA Firestore rules.
// It scopes every Shadow Agent cloud record to the signed-in Firebase user.
// Multiple PCs signed into the same CSPWALA/Firebase account can therefore
// share workflows/customer contexts, while other users cannot read them.

match /aiOperatorUsers/{userId}/{document=**} {
  allow read, write: if request.auth != null
                     && request.auth.uid == userId;
}
